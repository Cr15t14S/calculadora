---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto flex min-h-screen max-w-5xl flex-col items-center justify-center px-6 py-16 text-center">
    <span class="mb-4 inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300">
      Ingeniería Económica · Astro + React
    </span>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Calculadora Financiera
    </h1>
    <p class="mt-4 max-w-2xl text-slate-400">
      Proyecto base configurado con Astro, React y Tailwind CSS. Listo para implementar los módulos de
      interés compuesto, conversión de tasas, ecuaciones de valor y tablas de amortización.
    </p>
  </main>
</Layout>
